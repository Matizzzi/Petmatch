# Copia este archivo como .env (no lo subas): copy .env.example .env

# Base de datos (Neon por defecto). Postgres local: docker compose --profile local-db up --build
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"

# Seguridad y autenticación JWT
JWT_SECRET=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Gemini (visión / triaje). Dejar vacío hasta tener tu propia clave.
GEMINI_API_KEY=

# URL base del backend
BASE_URL="http://localhost:8000"
PORT=8000

# URL de la API para el frontend
EXPO_PUBLIC_API_URL=http://localhost:8000
